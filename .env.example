# Copy to .env and fill in. NEVER commit .env. Placeholders only.

# --- MySQL (application user: see database/migrations/002_grants_example.sql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_DATABASE=plc_gateway
# Optional: CA certificate path to enable TLS to MySQL
MYSQL_SSL_CA=

# Optional maintenance user (partition drop / audit retention). If empty, the app user is used.
MYSQL_MAINT_USER=
MYSQL_MAINT_PASSWORD=

# --- Emergency write disable (1 = reject every PLC write immediately)
GATEWAY_WRITE_DISABLE=0

# --- OPC UA credentials referenced by plants.yaml (username_env / password_env)
OPCUA_USERNAME=
OPCUA_PASSWORD=

# --- Central server forwarder token (referenced by settings.yaml integrations)
CENTRAL_SERVER_TOKEN=

# --- MQTT credentials (optional integration)
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Tests only
# MYSQL_TEST_DSN=mysql://gw_test:password@127.0.0.1:3306/plc_gateway_test
