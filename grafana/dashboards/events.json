{
  "uid": "plcgw-events",
  "title": "PLC Gateway - Events",
  "tags": [
    "plc-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "plcgw-mysql"
        },
        "query": "SELECT DISTINCT device_id FROM v_tags ORDER BY 1",
        "definition": "SELECT DISTINCT device_id FROM v_tags ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Events per hour by type",
      "type": "barchart",
      "datasource": {
        "type": "mysql",
        "uid": "plcgw-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "plcgw-mysql"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(time, '1h'), event_type AS metric, COUNT(*) AS value\nFROM v_events\nWHERE $__timeFilter(time) AND device_id IN (${device:sqlstring})\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Event log",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "plcgw-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "plcgw-mysql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT time, device_id, tag_id, event_type, previous_value, new_value, threshold, message\nFROM v_events\nWHERE $__timeFilter(time) AND device_id IN (${device:sqlstring})\nORDER BY time DESC LIMIT 1000"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
