          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_ts AS time, spool_rows AS `spool`\nFROM gateway_health WHERE $__timeFilter(snapshot_ts) AND device_id = '_gateway'\nORDER BY 1"
        }
