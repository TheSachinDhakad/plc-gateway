{
  "uid": "plcgw-health",
  "title": "PLC Gateway - Gateway & Device Health",
  "tags": [
    "plc-gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue size",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "plcgw-mysql"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "plcgw-mysql"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_ts AS time, queue_size AS `queue`\nFROM gateway_health WHERE $__timeFilter(snapshot_ts) AND device_id = '_gateway'\nORDER BY 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Spool rows (unsent to MySQL)",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "plcgw-mysql"
      },
      "targets": [
        {
          "datasource": {
